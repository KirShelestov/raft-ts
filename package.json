{
  "name": "raft-ts",
  "version": "0.1.0",
  "private": true,
  "description": "Raft consensus algorithm implemented step by step in TypeScript",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "cluster": "tsx scripts/cluster.ts",
    "status": "tsx scripts/status.ts",
    "test": "node --import tsx --test --test-reporter=spec \"test/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
